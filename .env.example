# 데일리 카드 백엔드 — 환경변수 예시
# 실제 값은 .env에 작성한다. .env는 절대 커밋하지 않는다(.gitignore 포함).

# PostgreSQL 연결 문자열
# 로컬: 직접 연결
DATABASE_URL="postgresql://user:password@localhost:5432/daily_card?schema=public"
# 서버리스(Vercel) 배포: Neon 등의 pooled 엔드포인트를 쓴다(커넥션 폭발 방지).
#   함수 인스턴스당 커넥션 1개로 제한하고 PgBouncer 모드를 명시한다.
# DATABASE_URL="postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"

# 마이그레이션용 직접(non-pooled) 연결. Neon은 -pooler 없는 URL을 쓴다.
# 로컬 개발이라면 DATABASE_URL과 같은 값을 넣어도 된다.
DIRECT_URL="postgresql://user:password@localhost:5432/daily_card?schema=public"

# HTTP 포트
PORT=3000

# 쿠키 서명 시크릿 (익명 식별자 쿠키 서명, P2). 강력한 랜덤값 사용.
COOKIE_SECRET="change-me-to-a-strong-random-secret"

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGINS="http://localhost:5173"
