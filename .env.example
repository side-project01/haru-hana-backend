# 데일리 카드 백엔드 — 환경변수 예시
# 실제 값은 .env에 작성한다. .env는 절대 커밋하지 않는다(.gitignore 포함).

# PostgreSQL 연결 문자열
# 로컬: 직접 연결
DATABASE_URL="postgresql://user:password@localhost:5433/daily_card?schema=public"
# 서버리스(Vercel) 배포: Neon 등의 pooled 엔드포인트를 쓴다(커넥션 폭발 방지).
#   함수 인스턴스당 커넥션 1개로 제한하고 PgBouncer 모드를 명시한다.
# DATABASE_URL="postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"

# 마이그레이션용 직접(non-pooled) 연결. Neon은 -pooler 없는 URL을 쓴다.
# 로컬 개발이라면 DATABASE_URL과 같은 값을 넣어도 된다.
DIRECT_URL="postgresql://user:password@localhost:5433/daily_card?schema=public"

# HTTP 포트
PORT=3000

# 쿠키 서명 시크릿 (익명 식별자 쿠키 검증, P2). 로그인 시 기존 익명 데이터를 옮길 때 쓴다.
# 기존 운영 값을 그대로 유지해야 한다 — 바꾸면 기존 앱의 anon_id 쿠키가 전부 무효가 된다.
COOKIE_SECRET="change-me-to-a-strong-random-secret"

# 로그인 세션 토큰 서명 시크릿 (P2). 강력한 랜덤값 사용.
AUTH_TOKEN_SECRET="change-me-to-a-strong-random-secret"

# Google OAuth "웹 애플리케이션" 클라이언트 ID. Android 앱의 serverClientId와 같은 값.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"

# Vercel Cron 호출 인증 시크릿. 강력한 랜덤값 사용. Vercel 대시보드에도 같은 이름으로 등록한다.
CRON_SECRET="change-me-to-a-strong-random-secret"

# FCM(오늘의 질문 알림) 발송용 Firebase 서비스 계정 키. 받은 JSON 파일 내용을 한 줄로 넣는다.
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성". 비밀값이므로 절대 커밋하지 않는다.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGINS="http://localhost:5173"
