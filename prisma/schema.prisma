// 데일리 카드 Prisma 스키마
// Answer 모델은 Phase 3에서 마이그레이션으로 추가한다.
// 학습 자료: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // native: 로컬 개발용. rhel-openssl-3.0.x: Vercel 서버리스 런타임용 엔진.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // 런타임: pooled 연결(PgBouncer). 서버리스 커넥션 폭발 방지.
  url = env("DATABASE_URL")
  // 마이그레이션: 직접(non-pooled) 연결. PgBouncer는 migrate가 쓰는 세션 기능을 막는다.
  // 로컬은 DATABASE_URL과 같은 값이어도 되고, Neon은 -pooler 없는 URL을 쓴다.
  directUrl = env("DIRECT_URL")
}

// 익명 사용자 (리텐션 지표용, PRD 7장)
model User {
  anonId    String   @id // 쿠키 익명 식별자 (P2)
  firstSeen DateTime @default(now()) // 최초 진입일
  lastSeen  DateTime @updatedAt // 마지막 활동일 (D1/D7 산정 기반)
}

// 오늘의 질문 (P3: 1일 1질문)
model Question {
  id          Int      @id @default(autoincrement())
  body        String
  displayDate DateTime @unique // KST serviceDate(자정, UTC 저장) 매칭 키 (P3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}
