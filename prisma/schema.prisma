// 데일리 카드 Prisma 스키마
// 학습 자료: https://pris.ly/d/prisma-schema

// Rust 엔진 없는 클라이언트(engineType = "client", v6.16+ GA).
// 번들이 약 14MB -> 1.6MB로 줄어 서버리스 콜드스타트를 단축한다.
// binaryTargets는 Rust 엔진이 없으므로 불필요.
// 커넥션 풀은 driver adapter(@prisma/adapter-pg)의 pg.Pool이 관리한다.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
  engineType   = "client"
  // 상대 import에 확장자를 붙이지 않는다. CJS라 불필요하고,
  // ".js" 확장자가 붙으면 Jest 리졸버가 생성 파일(.ts)을 찾지 못한다.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
  // 런타임: pooled 연결(PgBouncer). 서버리스 커넥션 폭발 방지.
  url = env("DATABASE_URL")
  // 마이그레이션: 직접(non-pooled) 연결. PgBouncer는 migrate가 쓰는 세션 기능을 막는다.
  // 로컬은 DATABASE_URL과 같은 값이어도 되고, Neon은 -pooler 없는 URL을 쓴다.
  directUrl = env("DIRECT_URL")
}

// Google 로그인 사용자 (P2). 개인정보 최소화를 위해 Google 고유 ID(sub)만 저장한다.
// 첫 로그인 때만 생성되며, 그때 기기의 익명(anon_id) 답변·배정을 이 계정으로 옮긴다.
model User {
  id                String    @id @default(uuid())
  googleSub         String    @unique // Google ID 토큰의 sub
  sessionsRevokedAt DateTime? // 로그아웃 시각. 이 시각까지 발급된 세션 토큰은 무효
  createdAt         DateTime  @default(now())
}

// Answer·OtherAnswerPick의 userId는 User를 FK로 참조하지 않는 문자열이다.
// 로그인 전 익명 시절 데이터가 옮겨지지 않은 채 anonId 값으로 남아 있을 수 있기 때문이다
// (보유 기간이 지나면 cron이 지운다).

// 오늘의 질문 (P3: 1일 1질문)
model Question {
  id          Int      @id @default(autoincrement())
  body        String
  displayDate DateTime @unique // KST serviceDate(자정, UTC 저장) 매칭 키 (P3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  answers     Answer[]
}

// 답변 (P1 하루 1회 · P4 배경 · P5 타인 답변)
model Answer {
  id          Int      @id @default(autoincrement())
  userId      String // 작성자. User.id, 미이전 익명 데이터는 anonId (P2)
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
  content     String // 답변 본문 (P6 금칙어 검사 후 저장)
  bgType      String // 카드 배경 타입 (color/gradient/image) (P4)
  bgValue     String // 카드 배경 값 (P4)
  serviceDate DateTime // KST 자정 기준 서비스 날짜 (P7)
  createdAt   DateTime @default(now())

  otherPicks OtherAnswerPick[] // 이 답변을 타인 답변으로 배정받은 사용자들 (P5)

  @@unique([userId, serviceDate]) // P1: 하루 1회 DB 레벨 강제
  @@index([questionId]) // P5: 타인 답변 조회
}

// 타인 답변 배정 (P5 고정 노출)
// 사용자가 한 질문에서 처음 뽑은 타인 답변을 기록해, 재조회·새로고침에도 같은 답변만 보이게 한다.
// answerId에는 유니크를 두지 않는다 — 같은 답변이 여러 사용자에게 배정될 수 있다(본인 답변과 1:1 아님).
model OtherAnswerPick {
  id         Int      @id @default(autoincrement())
  userId     String // 배정받은 사용자 (P2)
  questionId Int // 배정 단위. 질문은 하루 1개이므로(P3) 사실상 하루 1건
  answerId   Int
  answer     Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId]) // 사용자·질문당 배정 1건을 DB 레벨에서 강제 (P1의 하루1회와 같은 방식)
  @@index([answerId])
}
