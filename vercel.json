{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npx prisma generate && npm run build",
  "regions": ["sin1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    { "path": "/cron/purge-answers", "schedule": "0 18 * * *" },
    { "path": "/cron/notify-question", "schedule": "0 3 * * *" }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
